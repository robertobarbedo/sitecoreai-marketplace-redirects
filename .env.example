# Custom authorization (Sitecore Cloud Auth0) — see src/lib/marketplace-auth/README.md
#
# REQUIRED for the Test buttons. The live test runs on the server
# (/api/test), and that route only answers signed-in Sitecore users of this
# app. Without the client ID the rest of the app still works (listing,
# creating, editing, publishing), but every test reports "Could not run the
# test".
#
# Client ID of the app's SPA client credentials from the Cloud Portal
NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Marketplace app ID (sent as product_codes=mkp_<id> at login)
NEXT_PUBLIC_SITECORE_APP_ID=
# Defaults shown; override only if Sitecore changes them
# NEXT_PUBLIC_AUTH0_DOMAIN=auth.sitecorecloud.io
# NEXT_PUBLIC_AUTH0_AUDIENCE=https://api-webapp.sitecorecloud.io
# NEXT_PUBLIC_AUTH0_SCOPE=openid profile email offline_access
# AUTH0_ISSUER=https://auth.sitecorecloud.io/

# Optional: space-separated sources allowed to frame the app
# (default: 'self' https://*.sitecorecloud.io)
# CSP_FRAME_ANCESTORS=

# REQUIRED to save a Vercel bypass secret (site Settings → Vercel tab).
# Any passphrase of 16+ characters; the secret is AES-256-GCM sealed with a
# key derived from it and stored only in sealed form. Changing it makes saved
# secrets unreadable (re-enter them). Without it the Vercel tab refuses to save.
# SECRET_ENCRYPTION_KEY=
